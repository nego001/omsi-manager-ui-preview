{
  "name": "omsi-manager-nine-screens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop": "electron .",
    "test:security": "node --test electron/*.test.cjs",
    "test:recovery:fixture": "node --test scripts/temp-recovery-fixture.test.cjs scripts/temp-recovery-concurrency.test.cjs scripts/temp-recovery-orphan-review.test.cjs scripts/temp-recovery-identity.test.cjs scripts/temp-native-file-id.test.cjs scripts/temp-native-process-id.test.cjs scripts/temp-native-file-race.test.cjs scripts/temp-evidence-lifecycle.test.cjs scripts/temp-native-directory-enum.test.cjs scripts/temp-main-native-directory-backend.test.cjs native-lab/synthetic-operation-observer.test.cjs",
    "test:recovery:concurrency": "node --test scripts/temp-recovery-concurrency.test.cjs",
    "test:recovery:orphan": "node --test scripts/temp-recovery-orphan-review.test.cjs",
    "test:recovery:identity": "node --test scripts/temp-recovery-identity.test.cjs",
    "test:identity:windows": "node --test scripts/temp-native-file-id.test.cjs",
    "test:identity:process:windows": "node --test scripts/temp-native-process-id.test.cjs",
    "test:identity:race:windows": "node --test scripts/temp-native-file-race.test.cjs",
    "test:evidence:lifecycle": "node --test scripts/temp-evidence-lifecycle.test.cjs",
    "test:identity:directory:windows": "node --test scripts/temp-native-directory-enum.test.cjs",
    "test:bridge:native:windows": "node --test scripts/temp-main-native-directory-backend.test.cjs",
    "test:native:standalone": "node --test native-lab/native-executable.test.cjs",
    "test:witness": "node --test native-lab/synthetic-operation-ledger.test.cjs",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "package:win": "node scripts/package-windows.mjs",
    "test:inspection:e2e": "node scripts/desktop-inspection-e2e.mjs",
    "test:portable:windows": "node scripts/portable-windows-smoke.mjs",
    "test:witness:portable": "node --test native-lab/synthetic-operation-observer.test.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@electron/asar": "^3.4.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "@playwright/test": "^1.56.1",
    "electron": "^38.0.0",
    "@electron/packager": "^20.3.0"
  },
  "main": "electron/main.cjs"
}
